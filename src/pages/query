USE u156962179_Victus;

-- ------------------------------------------------------------
-- TABLE 1: thakarshi_enquiries
-- Enquiry form + Contact form submissions
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS thakarshi_enquiries (
  id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(255) NOT NULL,
  mobile VARCHAR(20) NOT NULL,
  email VARCHAR(255) DEFAULT NULL,
  config VARCHAR(100) DEFAULT NULL,
  message TEXT DEFAULT NULL,
  source VARCHAR(100) DEFAULT NULL,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_created (created_at),
  INDEX idx_mobile (mobile),
  INDEX idx_source (source)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ------------------------------------------------------------
-- TABLE 2: thakarshi_reviews
-- Testimonials / Reviews
-- ------------------------------------------------------------
CREATE TABLE IF NOT EXISTS thakarshi_reviews (
  id INT AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(255) NOT NULL,
  role VARCHAR(255) DEFAULT NULL,
  review TEXT NOT NULL,
  rating TINYINT DEFAULT 5,
  photo VARCHAR(500) DEFAULT NULL,
  is_active TINYINT(1) DEFAULT 1,
  sort_order INT DEFAULT 0,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  INDEX idx_created (created_at),
  INDEX idx_active (is_active, sort_order)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

